# AgentBridge release-review image (not production certified).
# Unpinned base images/requirements need release-locking before official GA.
FROM python:3.12-slim AS builder
WORKDIR /build
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m venv /venv && /venv/bin/pip install --no-cache-dir .

FROM python:3.12-slim
ENV PATH="/venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=builder /venv /venv
COPY --from=builder /build/src /app/src
# Disposable egress drill probe, no production secrets or external endpoints.
COPY tools/egress_docker_probe.py /app/tools/egress_docker_probe.py
RUN useradd --system --create-home --uid 10001 agentbridge
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)"
CMD ["uvicorn","src.api.control_plane:app","--host","0.0.0.0","--port","8000"]
