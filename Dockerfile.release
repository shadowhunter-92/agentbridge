# AgentBridge release-review image (not production certified).
# Alpine-based review candidate to remove unfixed Debian 13 runtime OS CVEs.
# Base pinned to digest captured from passing CI #316; Python dependencies still need hash locking.
FROM python:3.12-alpine3.22@sha256:a190708a2dec1bd18b1decb539f8e8f5407abaa9bf39cacda583f7f8c11db322 AS builder
RUN apk upgrade --no-cache
WORKDIR /build
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m venv /venv && /venv/bin/pip install --no-cache-dir .

FROM python:3.12-alpine3.22@sha256:a190708a2dec1bd18b1decb539f8e8f5407abaa9bf39cacda583f7f8c11db322
RUN apk upgrade --no-cache
ENV PATH="/venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=builder /venv /venv
COPY --from=builder /build/src /app/src
# Disposable egress drill probe, no production secrets or external endpoints.
COPY tools/egress_docker_probe.py /app/tools/egress_docker_probe.py
RUN addgroup -S -g 10001 agentbridge && adduser -S -D -H -u 10001 -G agentbridge agentbridge
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)"
CMD ["uvicorn","src.api.control_plane:app","--host","0.0.0.0","--port","8000"]
